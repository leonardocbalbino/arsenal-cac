# Copie este arquivo para `.env` ao lado do docker-compose.prod.yml no
# servidor e preencha os valores. Nunca commitar o `.env` real.

POSTGRES_USER=cac
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=cac_app
DATABASE_URL=postgresql://cac:troque-por-uma-senha-forte@db:5432/cac_app?schema=public

JWT_SECRET=troque-por-um-segredo-aleatorio
JWT_EXPIRES_IN=7d

# Porta pública deste stack no servidor (o cartao-colaborativa já usa 80/443
# e 3000/3001 — mantenha esta porta livre e diferente das dele).
PUBLIC_PORT=8090

# URL pública da API — embutida no build do web (Next.js lê NEXT_PUBLIC_*
# em build-time). Sem domínio ainda, use o IP do servidor + PUBLIC_PORT.
NEXT_PUBLIC_API_URL=http://SEU_IP_DO_SERVIDOR:8090/api
